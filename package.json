{
  "name": "@ryn-mic/web-chat",
  "version": "0.1.113",
  "description": "Mobile-friendly Web UI for pi and Codex coding agents",
  "type": "module",
  "license": "MIT",
  "author": "ryn-mic",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryn-Mic/pi-web-chat.git"
  },
  "homepage": "https://github.com/Ryn-Mic/pi-web-chat#readme",
  "bugs": {
    "url": "https://github.com/Ryn-Mic/pi-web-chat/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "codex",
    "coding-agent",
    "pwa",
    "web-ui",
    "chat"
  ],
  "bin": {
    "pi-web-chat": "bin/pi-web-chat.mjs"
  },
  "files": [
    "bin",
    "dist",
    "extensions",
    "third-party-licenses",
    "release-notes.json",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "wait-on -t 30s tcp:3141 && vite",
    "build": "node scripts/build.mjs",
    "build:web": "vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "start": "node bin/pi-web-chat.mjs",
    "typecheck": "tsc --noEmit",
    "notes:check:tree": "tsx .agents/skills/write-notes-like-deepseek/scripts/verify-agent-note-tree.ts",
    "notes:check:format": "tsx .agents/skills/write-notes-like-deepseek/scripts/verify-agent-note-format.ts",
    "notes:check": "npm run notes:check:tree && npm run notes:check:format",
    "prepack": "npm run build",
    "pack:check": "npm run build && node scripts/check-pack-size.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-web-chat.ts"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "file-viewer-copy-assets": "2.2.8",
    "ignore": "^7.0.6",
    "morphicons": "^1.7.0",
    "qrcode": "^1.5.4",
    "shiki": "^3.23.0",
    "streamdown": "^2.5.0",
    "ws": "^8.21.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@file-viewer/core": "2.2.8",
    "@file-viewer/react-full": "2.2.8",
    "@file-viewer/vite-plugin": "2.2.8",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^9.0.10"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
